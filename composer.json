{
    "name": "petertornstrand/codebase-mcp-server",
    "description": "Stand-alone MCP server for Codebase HQ.",
    "version": "1.0.1",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": "^8.3",
        "ext-curl": "*",
        "ext-json": "*",
        "ext-mbstring": "*",
        "onelogin/php-saml": "^4.2"
    },
    "autoload": {
        "classmap": [
            "src/"
        ]
    },
    "bin": [
        "build/codebase-mcp-server.phar"
    ],
    "config": {
        "sort-packages": true
    },
    "require-dev": {
        "phpunit/phpunit": "^11"
    },
    "autoload-dev": {
        "psr-4": {
            "petertornstrand\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit"
    }
}
